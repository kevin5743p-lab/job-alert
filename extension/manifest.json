{
  "manifest_version": 3,
  "name": "JobCopilot — Tailor",
  "version": "0.1.0",
  "description": "Tailor your CV and cover letter to the LinkedIn job you're viewing — grounded only in your real CV.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://jiryqdcmukmbflahtptv.supabase.co/*",
    "https://*.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobCopilot — set your CV & key"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/jobs/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
